# Server-only. Same value as MARKETING_LEAD_WEBHOOK_SECRET on the CRM.
CRM_LEAD_WEBHOOK_SECRET=
# Optional. Defaults to the live CRM webhook.
# CRM_LEAD_WEBHOOK_URL=https://zk-sports.trade/api/webhooks/marketing-lead

# Live CRM catalog + Stripe Checkout (server-only). Keep WEBSITE_CHECKOUT_ENABLED
# off until the CRM migration is live and a test-mode purchase has been verified.
CRM_ADGP_API_URL=https://zk-sports.trade/api/adgp
CRM_ADGP_SECRET=
WEBSITE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site origin used for canonical URLs, Open Graph and the sitemap.
# VITE_SITE_URL=https://abudhabi.zk-sports.com
# Optional. Omit until a GA4 property exists.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

